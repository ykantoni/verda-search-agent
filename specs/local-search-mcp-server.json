{
    "tools": [
      {
        "name": "search_documents",
        "description": "Search local PDF, DOC, DOCX and TXT files for information relevant to a question. Returns matching text snippets, source locations and chunk IDs.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Natural language search query"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          },
          "required": ["query"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "chunk_id": {"type": "string"},
                  "file": {"type": "string"},
                  "page": {"type": ["integer", "null"]},
                  "snippet": {"type": "string"},
                  "score": {"type": "number"}
                },
                "required": [
                  "chunk_id", "file", "page",
                  "snippet", "score"
                ]
              }
            }
          },
          "required": ["results"]
        }
      },
      {
        "name": "get_document_chunk",
        "description": "Retrieve the complete text of a document chunk by ID, including filename and page reference. Use after search_documents to obtain evidence for an answer.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "chunk_id": {
              "type": "string",
              "description": "Chunk ID returned by search_documents"
            }
          },
          "required": ["chunk_id"],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "chunk_id": {"type": "string"},
            "file": {"type": "string"},
            "page": {"type": ["integer", "null"]},
            "text": {"type": "string"}
          },
          "required": ["chunk_id", "file", "page", "text"]
        }
      }
    ]
  }